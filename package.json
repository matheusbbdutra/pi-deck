{
  "name": "sightdeck",
  "private": true,
  "version": "0.2.3",
  "description": "Desktop client for the pi coding agent",
  "scripts": {
    "tauri": "tauri",
    "dev": "tauri dev",
    "build": "tauri build",
    "build:ui": "vite build --config ui/vite.config.mjs",
    "build:ui:e2e": "vite build --config ui/vite.config.mjs --mode e2e",
    "build:e2e": "tauri build --debug --no-bundle --features e2e --config src-tauri/tauri.e2e.conf.json",
    "test:e2e": "wdio run wdio.conf.mjs",
    "dev:ui": "vite --config ui/vite.config.mjs",
    "test:ui": "vitest run"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "@wdio/cli": "^9.33.1",
    "@wdio/local-runner": "^9.33.1",
    "@wdio/mocha-framework": "^9.33.1",
    "@wdio/spec-reporter": "^9.33.1",
    "@wdio/tauri-plugin": "^1.5.1",
    "@wdio/tauri-service": "^1.5.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "jsdom": "^31.0.1",
    "prismjs": "^1.30.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "webdriverio": "^9.33.1"
  }
}
